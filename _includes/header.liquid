<header class="site-header">
  <nav id="navbar" class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Primary navigation">
    <div class="container">
      <a class="navbar-brand site-brand" href="{{ '/' | relative_url }}" aria-label="Yidong Zhou, home">
        <span class="brand-name">Yidong Zhou</span>
      </a>

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto align-items-lg-center">
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              Home{% if page.permalink == '/' %}<span class="sr-only"> (current)</span>{% endif %}
            </a>
          </li>

          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              {% assign nav_label = p.nav_title | default: p.title %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                {% if p.permalink contains '://' %}
                  <a class="nav-link" href="{{ p.permalink }}">{{ nav_label }}</a>
                {% else %}
                  <a class="nav-link" href="{{ p.url | relative_url }}">
                    {{ nav_label }}{% if page.url contains parent_link %}<span class="sr-only"> (current)</span>{% endif %}
                  </a>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}

          {% if site.search_enabled %}
            <li class="nav-item nav-action-item">
              <button id="search-toggle" class="site-icon-button" title="Search (Ctrl K)" aria-label="Search" onclick="openSearchModal()">
                <i class="ti ti-search" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="nav-item nav-action-item toggle-container">
              <button id="light-toggle" class="site-icon-button" title="Change color theme" aria-label="Change color theme">
                <span class="theme-symbol" aria-hidden="true">◐</span>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
