<script src="{{ site.third_party_libraries.jquery.url.js }}" integrity="{{ site.third_party_libraries.jquery.integrity.js }}" crossorigin="anonymous"></script>
<script src="{{ '/assets/js/bootstrap.bundle.min.js' | relative_url | bust_file_cache }}"></script>

{% if page.layout == 'about' or page.permalink == '/publications/' %}
  <script defer src="{{ '/assets/js/common.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if page.permalink == '/software/' %}
  <script defer src="{{ '/assets/js/copy_code.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if page.images.photoswipe %}
  <script defer src="{{ '/assets/js/photoswipe-setup.js' | relative_url | bust_file_cache }}" type="module"></script>
{% endif %}

{% if site.enable_google_analytics %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
  <script defer src="{{ '/assets/js/google-analytics-setup.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
