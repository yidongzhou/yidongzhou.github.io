{% if site.enable_google_verification or site.enable_bing_verification %}
  {% if site.enable_google_verification %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
  {% if site.enable_bing_verification %}<meta name="msvalidate.01" content="{{ site.bing_site_verification }}">{% endif %}
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% assign meta_description = page.description | default: site.description | strip_html | strip_newlines %}
{% if page.url == '/' %}
  {% assign meta_title = author_name %}
{% else %}
  {% capture meta_title %}{{ page.title }} | {{ author_name }}{% endcapture %}
{% endif %}
{% assign social_image = page.og_image | default: site.og_image %}
{% if social_image and social_image contains '://' %}
  {% assign social_image_url = social_image %}
{% elsif social_image %}
  {% assign social_image_url = social_image | absolute_url %}
{% endif %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ meta_title | strip }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ meta_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords | join: ', ' }}{% else %}{{ site.keywords | join: ', ' }}{% endif %}">
{% endif %}

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ author_name }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ meta_title | strip | escape }}">
  <meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  {% if social_image_url %}<meta property="og:image" content="{{ social_image_url }}">{% endif %}
  <meta property="og:locale" content="{{ site.lang }}">

  <meta name="twitter:card" content="{% if social_image_url %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ meta_title | strip | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {% if social_image_url %}<meta name="twitter:image" content="{{ social_image_url }}">{% endif %}
{% endif %}

{% if site.serve_schema_org %}
  {% assign same_as = '' | split: ',' %}
  {% if site.data.socials.orcid_id %}
    {% capture profile_url %}https://orcid.org/{{ site.data.socials.orcid_id }}{% endcapture %}
    {% assign same_as = same_as | push: profile_url %}
  {% endif %}
  {% if site.data.socials.scholar_userid %}
    {% capture profile_url %}https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}{% endcapture %}
    {% assign same_as = same_as | push: profile_url %}
  {% endif %}
  {% if site.data.socials.github_username %}
    {% capture profile_url %}https://github.com/{{ site.data.socials.github_username }}{% endcapture %}
    {% assign same_as = same_as | push: profile_url %}
  {% endif %}
  {% if site.data.socials.linkedin_username %}
    {% capture profile_url %}https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}{% endcapture %}
    {% assign same_as = same_as | push: profile_url %}
  {% endif %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if page.url == '/' %}ProfilePage{% else %}WebPage{% endif %}",
      "url": {{ page.url | absolute_url | jsonify }},
      "name": {{ meta_title | strip | jsonify }},
      "description": {{ meta_description | jsonify }},
      "mainEntity": {
        "@type": "Person",
        "name": {{ author_name | jsonify }},
        "url": {{ site.url | append: site.baseurl | jsonify }},
        "image": {{ site.og_image | jsonify }},
        "jobTitle": "Assistant Professor in Statistics",
        "sameAs": {{ same_as | jsonify }}
      }
    }
  </script>
{% endif %}
