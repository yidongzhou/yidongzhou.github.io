{% assign albums = site.photography | where_exp: 'album', 'album.published != false' | where: 'home_featured', true | sort: 'home_order' %}
{% if albums.size > 0 %}
  <div class="home-albums">
    {% for album in albums limit: 2 %}
      {% assign cover_path = album.url | append: album.cover %}
      <article class="home-album">
        <a href="{{ album.url | relative_url }}">
          {% include figure.liquid path=cover_path alt=album.cover_alt loading="lazy" width=album.cover_width height=album.cover_height sizes="(min-width: 992px) 300px, (min-width: 600px) 220px, 44vw" %}
          <p class="home-album-title">{{ album.title }}</p>
        </a>
        {% if album.location != album.title %}<p class="home-album-location">{{ album.location | remove_first: album.title | remove_first: ', ' }}</p>{% endif %}
      </article>
    {% endfor %}
  </div>
{% endif %}
