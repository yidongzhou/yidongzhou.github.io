{% assign albums = site.photography | where_exp: 'album', 'album.published != false' | where: 'home_featured', true | sort: 'home_order' %}
{% if albums.size > 0 %}
  <div class="photo-card-grid photo-card-grid--home">
    {% for album in albums %}{% include photo_card.liquid album=album %}{% endfor %}
  </div>
{% else %}
  <div class="photography-teaser">
    <p>A new home for occasional photo essays from hikes and travels. Albums are organized as lightweight, data-driven entries, so publishing the next one takes only an image folder and a short Markdown file.</p>
  </div>
{% endif %}
