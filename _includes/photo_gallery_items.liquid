{% assign gallery_photos = include.photos %}
{% if gallery_photos %}
  <div class="photo-gallery pswp-gallery"{% if include.id %} id="{{ include.id }}"{% endif %}>
    {% for photo in gallery_photos %}
      {% unless photo.file == include.cover %}
        {% assign photo_path = page.url | append: photo.file %}
        {% assign photo_layout = photo.layout %}
        {% if photo_layout == blank %}
          {% if photo.height > photo.width %}
            {% assign photo_layout = 'portrait' %}
          {% else %}
            {% assign photo_layout = 'landscape' %}
          {% endif %}
        {% endif %}
        <figure class="photo-gallery-item photo-gallery-item--{{ photo_layout }}">
          <a href="{{ photo_path | relative_url }}" data-pswp-width="{{ photo.width }}" data-pswp-height="{{ photo.height }}" target="_blank">
            <img
              src="{{ photo_path | relative_url }}"
              width="{{ photo.width }}"
              height="{{ photo.height }}"
              loading="lazy"
              decoding="async"
              alt="{{ photo.alt }}"
            >
          </a>
          {% if photo.caption or photo.credit %}
            <figcaption>
              {% if photo.caption %}{{ photo.caption }}{% endif %}
              {% if photo.credit %}<span class="photo-credit">Photo: {% if photo.source_url %}<a href="{{ photo.source_url }}">{{ photo.credit }}</a>{% else %}{{ photo.credit }}{% endif %}{% if photo.license %} · {{ photo.license }}{% endif %}</span>{% endif %}
            </figcaption>
          {% endif %}
        </figure>
      {% endunless %}
    {% endfor %}
  </div>
{% endif %}
