{% assign news = site.news | sort: 'date' | reverse %}
{% if include.featured_only %}
  {% assign news = news | where: 'featured', true %}
{% endif %}
{% if include.limit %}
  {% assign news = news | slice: 0, include.limit %}
{% endif %}
<div class="news-feed"{% unless include.featured_only %} data-news-feed data-archive-months="{{ site.news_archive_months | default: 6 }}"{% endunless %}>
  {% if news != blank %}
    <ol class="news-list" data-news-current>
      {% for item in news %}
        <li class="news-item" data-news-date="{{ item.date | date_to_xmlschema }}">
          <div class="news-meta">
            <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
          </div>
          <div class="news-copy">
            {% if include.featured_only and item.home_summary %}
              {{ item.home_summary | markdownify }}
            {% elsif item.inline %}
              {{ item.content | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
    {% unless include.featured_only %}
      <details class="news-archive" data-news-archive hidden>
        <summary>Earlier news <span data-news-archive-count></span></summary>
        <ol class="news-list news-list--archive" data-news-archive-list></ol>
      </details>
    {% endunless %}
  {% else %}
    <p class="empty-state">No news has been posted yet.</p>
  {% endif %}
</div>
{% unless include.featured_only %}
  <script defer src="{{ '/assets/js/news-archive.js' | relative_url | bust_file_cache }}"></script>
{% endunless %}
