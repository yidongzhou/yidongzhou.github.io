<footer class="site-footer" role="contentinfo">
  <div class="container footer-grid">
    <div>
      <a class="footer-name" href="{{ '/' | relative_url }}">Yidong Zhou</a>
      <p>{{ site.footer_text }}</p>
    </div>
    {% include visitor_map.liquid %}
    <div class="footer-meta">
      <div class="footer-links">
        <a href="{{ '/publications/' | relative_url }}">Publications</a>
        <a href="{{ '/news/' | relative_url }}">News</a>
        <a href="{{ '/photography/' | relative_url }}">Photography</a>
      </div>
      <p>&copy; {{ site.time | date: '%Y' }}{% if site.last_updated %} · Updated {{ 'now' | date: '%B %Y' }}{% endif %}</p>
    </div>
  </div>
</footer>
