{% if page.photo_sections %}
  <div class="photo-subalbums">
    {% for section in page.photo_sections %}
      <section class="photo-subalbum" aria-labelledby="photo-subalbum-{{ forloop.index }}">
        <header class="photo-subalbum-header">
          <p class="eyebrow">{% if section.eyebrow %}{{ section.eyebrow }}{% else %}Series {{ forloop.index }}{% endif %}</p>
          <h2 id="photo-subalbum-{{ forloop.index }}">{{ section.title }}</h2>
          {% if section.description %}<p>{{ section.description }}</p>{% endif %}
        </header>
        {% assign gallery_id = 'photo-gallery-' | append: forloop.index %}
        {% include photo_gallery_items.liquid photos=section.photos cover=page.cover id=gallery_id %}
      </section>
    {% endfor %}
  </div>
{% elsif page.photos %}
  {% include photo_gallery_items.liquid photos=page.photos cover=page.cover id='photo-gallery' %}
{% endif %}
