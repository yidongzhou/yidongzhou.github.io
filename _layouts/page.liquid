---
layout: default
---
{% if page._styles %}
  <style type="text/css">{{ page._styles }}</style>
{% endif %}

<article class="page-shell">
  <header class="page-hero">
    {% if page.eyebrow %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
    <h1>{{ page.title }}</h1>
    {% if page.description %}<p class="page-lead">{{ page.description }}</p>{% endif %}
  </header>

  <div class="page-content{% if page.wide_content %} page-content--wide{% endif %}">
    {{ content }}
  </div>

  {% if page.related_publications %}
    <section class="page-section">
      <h2>References</h2>
      <div class="publications">{% bibliography --cited_in_order %}</div>
    </section>
  {% endif %}
</article>
